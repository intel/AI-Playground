      "class_type": "VaeDecodeTextureTrellis",
      "_meta": {
        "title": "VaeDecodeTextureTrellis"
      }
    },
    "94": {
      "inputs": {
        "target_resolution": "1536",
        "positive": ["91", 0],
        "negative": ["91", 1],
        "shape_latent": ["18", 0],
