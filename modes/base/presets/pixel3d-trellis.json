        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1,
        "model": ["126", 0],
        "positive": ["91", 0],
        "negative": ["91", 1],
        "latent_image": ["91", 2]
      },
      "class_type": "KSampler",
      "_meta": {
        "title": "KSampler"
