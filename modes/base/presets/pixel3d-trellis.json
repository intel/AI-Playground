    "210": {
      "inputs": {
        "mesh": ["196", 0],
        "base_color": ["147", 0],
        "metallic": ["147", 1],
        "roughness": ["147", 2],
        "occlusion": ["233", 0],
        "normal_map": ["224", 0]
      },
      "class_type": "ApplyTextureToMesh",
      "_meta": {
        "title": "Apply Texture to Mesh"
