{
  "type": "comfy",
  "name": "Pixel3D-Trellis",
  "displayPriority": 320,
  "tags": ["Pixal3D", "TRELLIS.2", "no-prompt", "high-vram"],
  "backend": "comfyui",
  "category": "edit-images",
  "description": "Create a detailed 3D model with PBR textures from a single image",
  "extendedDescription": "Generate a 3D model with PBR textures from a 2D reference image. Load an image of an object against a plain background. Pixal3D is the default; enable TRELLIS.2 to use the alternative pipeline. Click generate without entering a prompt.",
  "toolCategory": "edit-images",
  "mediaType": "model3d",
  "toolInstructions": "Use this workflow when the user wants to convert a 2D image into a textured 3D model or mesh. This is a no-prompt workflow: the prompt parameter is ignored. It generates a 3D GLB mesh with PBR textures from the input image using Pixal3D or TRELLIS.2. Resource-intensive (high VRAM). Best for single objects with clear outlines rather than complex scenes.",
  "requiredCustomNodes": [],
  "requiredPythonPackages": [],
  "requiredComfyUiParameters": ["--use-quad-cross-attention"],
  "requiredModels": [
    {
      "type": "diffusion_models",
      "model": "Comfy-Org/Pixal3D/diffusion_models/pixal3d_int8_convrot.safetensors"
    },
    {
      "type": "diffusion_models",
      "model": "Comfy-Org/TRELLIS.2/diffusion_models/trellis_2_int8_convrot.safetensors"
    },
    {
      "type": "clip_vision",
      "model": "Comfy-Org/Pixal3D/clip_vision/dino_v3_L_naf_fp32.safetensors"
    },
    {
      "type": "geometry_estimation",
      "model": "Comfy-Org/MoGe/geometry_estimation/moge_2_vitl_normal_fp16.safetensors"
    },
    {
      "type": "background_removal",
      "model": "Comfy-Org/BiRefNet/background_removal/birefnet.safetensors"
    },
    {
      "type": "vae",
      "model": "Comfy-Org/Pixal3D/vae/trellis_2_shape_vae_bf16.safetensors"
    },
    {
      "type": "vae",
      "model": "Comfy-Org/Pixal3D/vae/trellis_2_texture_vae_bf16.safetensors"
    }
  ],
  "settings": [
    {
      "type": "image",
      "label": "Input Image",
      "displayed": true,
      "modifiable": true,
      "defaultValue": "",
      "nodeTitle": "Load Image",
      "nodeInput": "image"
    },
    {
      "type": "number",
      "label": "Base Steps",
      "displayed": true,
      "modifiable": true,
      "defaultValue": 12,
      "min": 1,
      "max": 50,
      "step": 1,
      "nodeTitle": "KSampler",
      "nodeInput": "steps"
    },
    {
      "type": "number",
      "label": "Image Size",
      "displayed": false,
      "modifiable": false,
      "defaultValue": 1024,
      "nodeTitle": "Crop Image to Mask",
      "nodeInput": "width"
    },
    {
      "type": "number",
      "label": "Image Size",
      "displayed": false,
      "modifiable": false,
      "defaultValue": 1024,
      "nodeTitle": "Crop Image to Mask",
      "nodeInput": "height"
    },
    {
      "type": "boolean",
      "label": "Use TRELLIS.2",
      "displayed": true,
      "modifiable": true,
      "defaultValue": false,
      "nodeTitle": "Boolean (Switch to Trellis2)",
      "nodeInput": "value"
    },
    {
      "type": "boolean",
      "label": "Remove Background",
      "displayed": true,
      "modifiable": true,
      "defaultValue": true,
      "nodeTitle": "Switch: Remove background",
      "nodeInput": "switch"
    },
    {
      "type": "number",
      "label": "Texture Resolution",
      "displayed": true,
      "modifiable": true,
      "defaultValue": 4096,
      "min": 1024,
      "max": 4096,
      "step": 512,
      "nodeTitle": "Texture Resolution",
      "nodeInput": "value"
    },
    {
      "type": "number",
      "label": "Target Face Count",
      "displayed": true,
      "modifiable": true,
      "defaultValue": 700000,
      "min": 50000,
      "max": 1500000,
      "step": 50000,
      "nodeTitle": "Decimate Mesh",
      "nodeInput": "target_face_count"
    }
  ],
  "comfyUiApiWorkflow": {
