      "class_type": "RescaleCFG",
      "_meta": {
        "title": "RescaleCFG"
      }
    },
    "126": {
      "inputs": {
        "multiplier": 0.5,
        "model": ["279", 0]
      },
      "class_type": "RescaleCFG",
