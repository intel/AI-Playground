# Snapshot of the model directories as first loaded, written at runtime so
# "restore defaults" has a pristine copy to restore to (see PathsManager).
WebUI/external/*.defaults.json

*.DS_Store
*.pyc

*.7z
*.whl
*.tar.gz
hijacks/
ComfyUI/
ollama-service/
env
llama-cpp-env/
LlamaCPP/
OpenVINO/ovms
OpenVINO/ovms.zip
*env_tmp/
*service_tmp/
*-env/
build-envs/
portable-git/
models/
# ...but that blanket rule also matches source directories named "models". The vendored
# Qwen3-TTS tree has one, and the frontend has two, and git cannot re-include files whose
# parent directory is excluded, so each directory itself has to be negated.
!qwen3-tts/vendor/qwen_tts/core/models/
!WebUI/src/assets/js/models/
!WebUI/src/components/models/

# Home Agent — runtime Telegram chat id (local dev); never commit
home-agent/.*id

# Laminar tracing — local project API keys (dev opt-in); never commit
WebUI/external/laminar.dev.json
WebUI/external/laminar.localhost.json
